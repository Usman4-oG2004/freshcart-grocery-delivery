# ==========================================
# FreshCart - Environment Variables Template
# ==========================================
# Copy this to .env and fill in your values
# Never commit .env to version control!

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
MONGO_URI=mongodb://localhost:27017/freshcart
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/freshcart

# ---- JWT ----
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ---- Firebase Cloud Messaging (Push Notifications) ----
FCM_SERVER_KEY=your_firebase_server_key_here

# ---- Google Maps (Geocoding & Directions) ----
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ---- Cloudinary (Image Uploads - optional) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- CORS ----
CORS_ORIGIN=*
